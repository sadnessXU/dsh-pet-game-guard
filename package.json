{
  "name": "dsh-pet-game-guard",
  "version": "0.1.0",
  "description": "打游戏时自动把 dsh-pet 桌宠收起来，退出游戏后放回来：全屏应用与游戏进程双重判定，只动窗口可见性，不改插件配置。",
  "icon": "icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-pet",
    "desktop-pet",
    "game",
    "fullscreen",
    "windows"
  ],
  "type": "module",
  "main": "lib/index.js",
  "os": [
    "win32"
  ],
  "homepage": "https://github.com/sadnessXU/dsh-pet-game-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadnessXU/dsh-pet-game-guard.git"
  },
  "bugs": {
    "url": "https://github.com/sadnessXU/dsh-pet-game-guard/issues"
  },
  "files": [
    "lib",
    "assets/PetGuard.exe",
    "assets/config.ini",
    "assets/PetGuard.cs",
    "assets/app.manifest",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
